---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/lab.css';

const collaborators = [
  'Yuxuan Chen', 'Samuel Yeh', 'Sharon Li', 'Yang Xu', 'Jwala Dhamala', 'Ousmane Dia', 'Rahul Gupta',
  'Sining Zhoubian', 'Tianyi Tang', 'An Yang', 'Sean Du', 'Chujie Zheng', 'Fei Huang', 'Dayiheng Liu',
  'Gao Huang', 'Jingren Zhou', 'Jia Li', 'Ge Li', 'Zhi Jin', 'Yihong Dong', 'Yiming Zheng', 'Zhexin Zhang',
  'Yuan Yuan', 'Minlie Huang', 'Hong Mei', 'Tatia M. C. Lee', 'Maximillian Chen', 'Michael Peng', 'Zhou Yu',
  'Alexandros Papangelis', 'Yohan Jo', 'Dan Roth'
];

const institutions = [
  ['Stanford University', 'Research background'],
  ['Tsinghua University', 'Publication network'],
  ['University of Wisconsin–Madison', 'Publication network'],
  ['Imperial College London', 'Research network'],
  ['Peking University', 'Publication network'],
  ['University of Hong Kong', 'Publication network']
];
---

<SiteLayout title="Faculty | Worldeology Lab" description="Faculty and research collaborators connected to Worldeology Lab." headerTone="paper" active="faculty" image="/og.png">
  <main id="main" class="lab-site lab-page">
    <header class="lab-page-hero faculty-directory-hero">
      <p class="lab-index">Worldeology Lab / Faculty</p>
      <h1>Faculty</h1>
      <p>Researchers building Cognitive AI across mechanisms, minds, and long-horizon worlds.</p>
    </header>

    <section class="lab-page-section" aria-labelledby="faculty-core">
      <header><p class="lab-index">01 / Founding faculty</p><h2 id="faculty-core">The person building Worldeology.</h2></header>
      <div class="people-grid people-grid-single">
        <article class="person-card member">
          <img src="/assets/images/xuanming-zhang-color.webp" width="1400" height="1400" alt="Xuanming Zhang" />
          <div>
            <span>Founder · Faculty</span>
            <h3>Xuanming Zhang</h3>
            <p>Cognitive AI, Theory of Mind, reflective reasoning, inference-time mechanisms, and long-horizon interactive worlds.</p>
            <nav><a href="/faculty/zhangxm/">Faculty profile →</a><a href="https://scholar.google.com/citations?user=zP5k9lsAAAAJ">Scholar ↗</a></nav>
          </div>
        </article>
      </div>
    </section>

    <section class="lab-page-section collaboration-section" aria-labelledby="collab-title">
      <header><p class="lab-index">02 / Collaboration</p><h2 id="collab-title">A publication network spanning universities and frontier AI teams.</h2></header>

      <div class="institution-index" aria-label="Institutions represented in the research network">
        {institutions.map(([name, relation], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{name}</h3><p>{relation}</p></article>)}
      </div>

      <div class="industry-network">
        <p class="lab-index">Industry research represented in the publication network</p>
        <div class="industry-marks">
          <div><img src="/assets/marks/alibaba.svg" alt="Alibaba" loading="lazy" /></div>
          <div><img src="/assets/marks/amazon.svg" alt="Amazon" loading="lazy" /></div>
          <div><img src="/assets/marks/ibm.svg" alt="IBM" loading="lazy" /></div>
          <div><img src="/assets/marks/microsoft.svg" alt="Microsoft" loading="lazy" /></div>
          <div><img src="/assets/marks/meta.png" alt="Meta" loading="lazy" /></div>
        </div>
      </div>

      <div class="collaborator-index">
        <header><p class="lab-index">Publication collaborators</p><p>Names are drawn from public author lists and co-author records. Inclusion indicates shared published work, not lab membership.</p></header>
        <div>{collaborators.map((name) => <span>{name}</span>)}</div>
        <nav><a href="https://scholar.google.com/citations?user=zP5k9lsAAAAJ">Full publication record ↗</a><a href="https://arxiv.org/abs/2505.18943">MetaMind author list ↗</a><a href="https://arxiv.org/abs/2509.23441">Cognition-of-Thought author list ↗</a></nav>
      </div>
    </section>
    <SiteFooter />
  </main>
</SiteLayout>
