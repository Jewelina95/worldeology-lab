---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/lab.css';

const teamLeads = [
  {
    name: 'Yonghang Chen',
    role: 'Head of Architecture',
    links: [{ label: 'GitHub', href: 'https://github.com/Xgogu' }]
  },
  {
    name: 'Yuxuan Chen',
    role: 'Head of Engineering',
    links: [{ label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=4d2nNo8AAAAJ&hl=en' }]
  },
  {
    name: 'Jewelina Wen',
    role: 'Head of Operation and Design',
    links: [{ label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=5b0nSSMAAAAJ&hl=zh-CN' }]
  }
];

const institutions = [
  'Stanford University',
  'Tsinghua University',
  'University of Wisconsin–Madison',
  'Imperial College London',
  'Peking University',
  'University of Hong Kong',
  'Zhejiang University',
  'University of Michigan',
  'University of Washington'
];
---

<SiteLayout title="Faculty | Worldeology" description="Faculty and research collaborators connected to Worldeology." headerTone="paper" active="faculty" image="/og.png">
  <main id="main" class="lab-site lab-page">
    <header class="lab-page-hero faculty-directory-hero">
      <p class="lab-index">Worldeology / Faculty</p>
      <h1>Faculty</h1>
      <p>Meet the team building Worldeology and the research network it works with.</p>
    </header>

    <section class="lab-page-section" aria-labelledby="faculty-core">
      <header><p class="lab-index">Worldeology team</p><h2 id="faculty-core">Leadership</h2></header>
      <div class="people-grid people-grid-single">
        <article class="person-card member">
          <img src="/assets/images/xuanming-zhang-color.webp" width="1400" height="1400" alt="Xuanming Zhang" />
          <div>
            <span>Founder · Faculty</span>
            <h3>Xuanming Zhang</h3>
            <p>Dedicated to Cognitive AI, SI Architecture, and Causal World Modeling.</p>
            <nav><a href="/faculty/zhangxm/">Faculty profile →</a><a href="https://scholar.google.com/citations?user=zP5k9lsAAAAJ">Scholar ↗</a></nav>
          </div>
        </article>
      </div>
      <ul class="team-leads">
        {teamLeads.map(({ name, role, links }) => (
          <li>
            <div>
              <h3>{name}</h3>
              <p>{role}</p>
            </div>
            <div class="team-lead-links">
              {links.map(({ label, href }) => (
                <a href={href} aria-label={`${name} on ${label}`}>{label} <span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="lab-page-section collaboration-section" aria-labelledby="collab-title">
      <header><p class="lab-index">02 / Collaboration</p><h2 id="collab-title">Connecting academic research and industry.</h2></header>

      <div class="academic-network">
        <p class="lab-index">Universities &amp; Research Institutions</p>
        <p class="network-intro">Worldeology’s research community connects expertise in AI, cognition, and interactive systems across universities and research groups.</p>
        <div class="institution-index" aria-label="Universities and research institutions in the research network">
          {institutions.map((name, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{name}</h3></article>)}
        </div>
      </div>

      <div class="industry-network">
        <p class="lab-index">Industry</p>
        <p class="network-intro">Connections across frontier AI research, model development, and applied systems.</p>
        <div class="industry-marks">
          <div><img src="/assets/marks/alibaba.svg" alt="Alibaba" loading="lazy" /></div>
          <div><img src="/assets/marks/amazon.svg" alt="Amazon" loading="lazy" /></div>
          <div><img src="/assets/marks/ibm.svg" alt="IBM" loading="lazy" /></div>
          <div><img src="/assets/marks/microsoft.svg" alt="Microsoft" loading="lazy" /></div>
          <div><img src="/assets/marks/meta.png" alt="Meta" loading="lazy" /></div>
        </div>
      </div>

    </section>
    <SiteFooter />
  </main>
</SiteLayout>

<style>
  .team-leads {
    width: min(760px, 100%);
    margin: 36px auto 0;
    padding: 0;
    border-top: 1px solid var(--lab-line);
    list-style: none;
  }

  .team-leads li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--lab-line);
  }

  .team-leads h3 {
    margin: 0 0 4px;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
  }

  .team-leads p {
    margin: 0;
    font-size: .88rem;
  }

  .team-lead-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .team-lead-links a {
    border-bottom: 1px solid currentColor;
    font-size: .75rem;
    font-weight: 700;
  }
</style>
