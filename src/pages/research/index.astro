---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/lab.css';
---
<SiteLayout title="Research — Worldeology Lab" description="Four connected research fields: Cognitive AI, Learning from Cognition, Engine of World, and Architecture of Intelligence." headerTone="paper" active="research" image="/og.png">
  <main id="main" class="lab-site lab-page research-page research-directory">
    <header class="lab-page-hero research-page-hero">
      <p class="lab-index">Worldeology Lab / Research</p>
      <h1>Research</h1>
      <p>Four connected fields follow intelligence from hidden cognition to learning, world models, and architecture.</p>
    </header>

    <section class="research-directory-body" aria-labelledby="research-overview-title">
      <p id="research-overview-title" class="lab-index">Research program</p>
      <div class="research-directory-note">
        <p>Worldeology studies intelligence as a trajectory: how a system understands hidden cognition, learns from experience, reasons within a world, and revises the architecture through which it thinks.</p>
        <p>Use the Research menu above to enter one of the four independent fields.</p>
      </div>
    </section>
    <SiteFooter />
  </main>
</SiteLayout>
