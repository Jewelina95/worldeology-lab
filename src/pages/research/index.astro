---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/lab.css';
---
<SiteLayout title="Research — Worldeology Lab" description="Four connected research programs for Cognitive AI: cognition, learning, world engines, and intelligence architecture." headerTone="paper" active="research" image="/og.png">
  <main id="main" class="lab-site lab-page">
    <header class="lab-page-hero">
      <p class="lab-index">Worldeology Lab / Research</p>
      <h1>Four fields.<br />One trajectory.</h1>
      <p>Worldeology studies intelligence from the hidden state behind an instruction to the architectures that learn, act, and change a world.</p>
    </header>

    <section class="lab-page-section" aria-labelledby="program-title">
      <header>
        <p class="lab-index">01 / Research programs</p>
        <h2 id="program-title">Open a field to see the questions and work inside it.</h2>
      </header>

      <div class="research-programs">
        <details id="cognitive-ai" class="research-program program-cognitive" open>
          <summary><span>01</span><strong>Cognitive AI</strong><i>Black</i></summary>
          <div class="program-body">
            <p>Cognitive AI moves beyond passive response. It infers the unspoken state behind an instruction, monitors how reasoning changes, and models what an action leaves behind over time.</p>
            <div class="program-work-list" aria-label="Cognitive AI work">
              <a href="/blog/MetaMind/technical-contribution/"><span>MetaMind</span><small>Before the answer · modeling unspoken minds</small><i>↗</i></a>
              <a href="/blog/MetaMind/cognitive-frontier/"><span>Cognition-of-Thought</span><small>Inside the answer · reflective and revisable cognition</small><i>↗</i></a>
              <a href="/projects/mariolm/"><span>MarioLM</span><small>Beyond the answer · consequential interactive worlds</small><i>↗</i></a>
            </div>
          </div>
        </details>

        <details id="learning-from-cognition" class="research-program program-learning">
          <summary><span>02</span><strong>Learning from Cognition</strong><i>Blue</i></summary>
          <div class="program-body"><p>Experience becomes cognition through reflection and abstraction. This program studies how test-time evidence, prediction error, memory, and self-examination can become persistent capability rather than another stored transcript.</p></div>
        </details>

        <details id="engine-of-world" class="research-program program-world">
          <summary><span>03</span><strong>Engine of World</strong><i>Green</i></summary>
          <div class="program-body"><p>Interactive intelligence needs more than a static scene. We model latent state, causal event chains, relationships, world rules, and future branches so that an agent can reason across a full horizon.</p></div>
        </details>

        <details id="architecture-of-intelligence" class="research-program program-architecture">
          <summary><span>04</span><strong>Architecture of Intelligence</strong><i>Red</i></summary>
          <div class="program-body"><p>We study the semantic, knowledge, and structural bottlenecks that constrain current models, then design inference-time and learning architectures that can revise their own cognitive boundary.</p></div>
        </details>
      </div>
    </section>

    <section class="lab-page-section" aria-labelledby="dimensions-title">
      <header><p class="lab-index">02 / Cognitive dimensions</p><h2 id="dimensions-title">What a cognitive system must eventually support.</h2></header>
      <div class="lab-principles">
        <article><b>01</b><h3>Long / full horizon</h3><p>Maintain resolution, attention, and causal structure across extended language and event trajectories.</p></article>
        <article><b>02</b><h3>Personalization</h3><p>Adapt interpretation and action to the person, context, and evolving relationship.</p></article>
        <article><b>03</b><h3>Subjectivity</h3><p>Represent preferences, aesthetics, social meaning, and uncertain latent states without reducing them to a single rigid score.</p></article>
        <article><b>04</b><h3>Agency</h3><p>Actively discover missing information, ask when needed, and choose a useful reasoning strategy.</p></article>
        <article><b>05</b><h3>Generalization</h3><p>Carry abstractions beyond memorized patterns into new people, tasks, and worlds.</p></article>
        <article><b>06</b><h3>Creativity</h3><p>Produce new cognitive patterns and hypotheses rather than only recombining familiar answers.</p></article>
      </div>
    </section>
    <SiteFooter />
  </main>
  <script>
    const programs = [...document.querySelectorAll<HTMLDetailsElement>('.research-program')];
    const openFromHash = () => {
      if (!location.hash) return;
      const target = document.querySelector<HTMLDetailsElement>(location.hash);
      if (!target?.classList.contains('research-program')) return;
      programs.forEach((program) => { program.open = program === target; });
    };
    programs.forEach((program) => program.addEventListener('toggle', () => {
      if (!program.open) return;
      programs.forEach((other) => { if (other !== program) other.open = false; });
    }));
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  </script>
</SiteLayout>
