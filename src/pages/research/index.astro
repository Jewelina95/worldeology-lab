---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ResearchFieldNav from '../../components/ResearchFieldNav.astro';
import '../../styles/lab.css';
---
<SiteLayout title="Research — Worldeology Lab" description="Four connected research fields: Cognitive AI, Learning from Cognition, Engine of World, and Architecture of Intelligence." headerTone="paper" active="research" image="/og.png">
  <main id="main" class="lab-site lab-page research-page research-directory">
    <header class="lab-page-hero research-page-hero">
      <p class="lab-index">Worldeology Lab / Research</p>
      <h1>Research</h1>
      <p>Four connected fields follow intelligence from hidden cognition to learning, world models, and architecture.</p>
    </header>

    <section class="research-directory-body" aria-labelledby="fields-title">
      <p id="fields-title" class="lab-index">Research fields</p>
      <ResearchFieldNav />
      <div class="research-directory-note">
        <p>Each field has its own proposition and body of work. Select a direction to enter its research page.</p>
      </div>
    </section>
    <SiteFooter />
  </main>
</SiteLayout>
