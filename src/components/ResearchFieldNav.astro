---
interface Props { active?: string }
const { active = '' } = Astro.props;
const fields = [
  { slug: 'cognitive-ai', name: 'Cognitive AI', tone: 'black' },
  { slug: 'learning-from-cognition', name: 'Learning from Cognition', tone: 'blue' },
  { slug: 'engine-of-world', name: 'Engine of World', tone: 'green' },
  { slug: 'architecture-of-intelligence', name: 'Architecture of Intelligence', tone: 'red' }
];
---
<nav class="research-field-nav" aria-label="Research fields">
  {fields.map((field) => (
    <a
      class:list={[`field-${field.tone}`, active === field.slug && 'is-active']}
      href={`/research/${field.slug}/`}
      aria-current={active === field.slug ? 'page' : undefined}
    >
      <i aria-hidden="true"></i><span>{field.name}</span>
    </a>
  ))}
</nav>
