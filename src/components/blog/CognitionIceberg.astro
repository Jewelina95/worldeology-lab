<script>
  const icebergLayers = {
    dialogue: {
      kicker: 'Observable signal',
      title: 'Dialogue',
      copy: 'What participants explicitly say in the current turn—the visible trace, not the belief or intent behind it.',
    },
    image: {
      kicker: 'Observable signal',
      title: 'Image',
      copy: 'A still visual observation: objects, expressions, spatial relations, and other evidence available in the current moment.',
    },
    video: {
      kicker: 'Observable signal',
      title: 'Video',
      copy: 'Time-based evidence: motion, timing, interaction, and change across frames before hidden causes are inferred.',
    },
    scene: {
      kicker: 'World model',
      title: 'Scene',
      copy: 'Identity, world rules, goals, and boundaries. The scene changes only when interaction materially changes the world.',
    },
    latent: {
      kicker: 'Internal state',
      title: 'Latent state',
      copy: 'Beliefs, relationships, emotion, and uncertainty—the hidden state that shifts before behavior changes.',
    },
    event: {
      kicker: 'Temporal reasoning',
      title: 'Event chain',
      copy: 'Past events explain the present. The present branches into advance, maintain, degrade, or collapse.',
    },
    cognitive: {
      kicker: 'Adaptive intelligence',
      title: 'Cognitive AI',
      copy: 'It infers missing structure, updates that model across time, and uses the result to change the next action.',
    },
  } as const;

  const storyStages = [
    {
      key: 'surface',
      title: 'Signals arrive.',
      copy: 'Dialogue, image, and video reveal what happened — only the visible trace.',
      lightDepth: '18%',
      traceDepth: '0%',
    },
    {
      key: 'scene',
      title: 'The world takes shape.',
      copy: 'Scene identifies the people, goals, boundaries, and rules that give the observation meaning.',
      lightDepth: '42%',
      traceDepth: '25%',
    },
    {
      key: 'latent',
      title: 'Hidden states update.',
      copy: 'Beliefs, emotion, relationships, and uncertainty shift beneath fluent behavior.',
      lightDepth: '57%',
      traceDepth: '50%',
    },
    {
      key: 'event',
      title: 'The future branches.',
      copy: 'The event chain remembers how earlier choices narrow or open what can happen next.',
      lightDepth: '72%',
      traceDepth: '76%',
    },
    {
      key: 'cognitive',
      title: 'Cognition changes the next action.',
      copy: 'Cognitive AI preserves hidden structure, revises it with evidence, and acts on what changed.',
      lightDepth: '88%',
      traceDepth: '100%',
    },
  ] as const;

  const storyDuration = 18_000;
  const stageDuration = storyDuration / storyStages.length;

  document.querySelectorAll<HTMLElement>('[data-cognition-iceberg]').forEach((root) => {
    const card = root.querySelector<HTMLElement>('[data-iceberg-card]');
    const kicker = root.querySelector<HTMLElement>('[data-iceberg-kicker]');
    const title = root.querySelector<HTMLElement>('[data-iceberg-title]');
    const copy = root.querySelector<HTMLElement>('[data-iceberg-copy]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-iceberg-layer]')];
    const storyCount = root.querySelector<HTMLElement>('[data-iceberg-story-count]');
    const storyTitle = root.querySelector<HTMLElement>('[data-iceberg-story-title]');
    const storyCopy = root.querySelector<HTMLElement>('[data-iceberg-story-copy]');
    const playButton = root.querySelector<HTMLButtonElement>('[data-iceberg-play]');
    const playIcon = root.querySelector<HTMLElement>('[data-iceberg-play-icon]');
    const playLabel = root.querySelector<HTMLElement>('[data-iceberg-play-label]');
    const timeLabel = root.querySelector<HTMLElement>('[data-iceberg-time]');
    if (!card || !kicker || !title || !copy || !storyCount || !storyTitle || !storyCopy || !playButton || !playIcon || !playLabel || !timeLabel) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let elapsed = reducedMotion ? storyDuration - 1 : 0;
    let previousTime = performance.now();
    let currentStage = -1;
    let manuallyPaused = reducedMotion;
    let inView = true;

    const formatTime = (milliseconds: number) => `00:${String(Math.min(18, Math.floor(milliseconds / 1000))).padStart(2, '0')}`;

    const setStoryStage = (index: number) => {
      if (index === currentStage) return;
      currentStage = index;
      const stage = storyStages[index];
      root.dataset.storyStage = stage.key;
      root.style.setProperty('--story-depth', stage.lightDepth);
      root.style.setProperty('--trace-depth', stage.traceDepth);
      storyCount.textContent = `${String(index + 1).padStart(2, '0')} / 05`;
      storyTitle.textContent = stage.title;
      storyCopy.textContent = stage.copy;
    };

    const isPaused = () => manuallyPaused || !inView;

    const syncPlayback = () => {
      const paused = isPaused();
      root.classList.toggle('is-paused', paused);
      playButton.setAttribute('aria-pressed', String(paused));
      playButton.setAttribute('aria-label', paused ? 'Play the cognition iceberg sequence' : 'Pause the cognition iceberg sequence');
      playIcon.textContent = paused ? '▶' : 'Ⅱ';
      playLabel.textContent = paused ? 'Play' : 'Pause';
    };

    const closeCard = () => {
      card.hidden = true;
      root.classList.remove('has-card');
      buttons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.icebergLayer as keyof typeof icebergLayers;
        const layer = icebergLayers[key];
        if (!layer) return;
        const wasOpen = button.getAttribute('aria-expanded') === 'true';
        closeCard();
        if (wasOpen) return;
        const storyKey = key === 'dialogue' || key === 'image' || key === 'video' ? 'surface' : key;
        const selectedStage = storyStages.findIndex((stage) => stage.key === storyKey);
        if (selectedStage >= 0) {
          elapsed = selectedStage * stageDuration + 120;
          setStoryStage(selectedStage);
        }
        kicker.textContent = layer.kicker;
        title.textContent = layer.title;
        copy.textContent = layer.copy;
        card.hidden = false;
        root.classList.add('has-card');
        button.setAttribute('aria-expanded', 'true');
        manuallyPaused = true;
        syncPlayback();
      });
    });

    root.querySelector('[data-iceberg-close]')?.addEventListener('click', closeCard);
    playButton.addEventListener('click', () => {
      closeCard();
      manuallyPaused = !manuallyPaused;
      previousTime = performance.now();
      syncPlayback();
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeCard();
    });

    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      previousTime = performance.now();
      syncPlayback();
    }, { threshold: .15 });
    observer.observe(root);

    const renderStory = (time: number) => {
      if (!isPaused()) elapsed = (elapsed + Math.max(0, time - previousTime)) % storyDuration;
      previousTime = time;
      const stageIndex = Math.min(storyStages.length - 1, Math.floor(elapsed / stageDuration));
      setStoryStage(stageIndex);
      root.style.setProperty('--story-progress', `${(elapsed / storyDuration) * 100}%`);
      timeLabel.textContent = `${formatTime(elapsed)} / 00:18`;
      requestAnimationFrame(renderStory);
    };

    setStoryStage(reducedMotion ? storyStages.length - 1 : 0);
    syncPlayback();
    requestAnimationFrame(renderStory);
  });
</script>
